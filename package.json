{
  "name": "ipqc-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently -n web,api -c green,cyan \"pnpm --filter @ipqc/web dev\" \"pnpm --filter @ipqc/api run dev\"",
    "dev:web": "pnpm --filter @ipqc/web dev",
    "dev:api": "pnpm --filter @ipqc/api run dev",
    "build": "pnpm --filter @ipqc/web build && pnpm --filter @ipqc/api run build",
    "test": "pnpm --filter @ipqc/web test && pnpm --filter @ipqc/api test",
    "lint": "pnpm --filter @ipqc/web lint && pnpm --filter @ipqc/api lint",
    "prisma:generate": "prisma generate",
    "apply:ledger-bindings": "node scripts/apply-ledger-default-bindings.mjs",
    "apply:ledger-bindings:force": "node scripts/apply-ledger-default-bindings.mjs --force",
    "clean:ledger-sync": "node scripts/clean-ledger-sync-data.mjs",
    "clean:ledger-sync:dry-run": "node scripts/clean-ledger-sync-data.mjs --dry-run"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prisma": "^6.19.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  }
}
