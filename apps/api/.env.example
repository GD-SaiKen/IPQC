PORT=3006
DATABASE_URL=postgresql://ipqc:ipqc@localhost:5432/ipqc

AUTH_WEB_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=false

# 默认管理员（库中无该用户或无密码时，用下列凭证登录会自动开户/补齐）
AUTH_BOOTSTRAP_PHONE=13800000000
AUTH_BOOTSTRAP_PASSWORD=Aasd1234
AUTH_BOOTSTRAP_DISPLAY_NAME=管理员
AUTH_BOOTSTRAP_ROLE=admin

# 以下仅共享盘台账同步需要；纯登录可不配
# DATA_HUB_API_ORIGIN=http://localhost:5175
# DATA_HUB_PUBLIC_ORIGIN=http://localhost:5175
# DATA_HUB_OAUTH_CLIENT_ID=
# DATA_HUB_OAUTH_CLIENT_SECRET=
# DATA_HUB_OAUTH_RESOURCE=http://localhost:5175/mcp
# DATA_HUB_TOKEN_KEY=
# 须在 data-hub OAuth 客户端登记，与浏览器访问 IPQC 的地址一致
# IPQC_DATA_HUB_REDIRECT_URI=http://localhost:5176/data/data-hub/callback