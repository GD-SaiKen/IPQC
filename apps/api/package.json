{
  "name": "@ipqc/api",
  "version": "0.1.0",
  "private": true,
  "description": "IPQC 统一身份登录 API",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm run build && concurrently -k -n tsc,api -c yellow,cyan \"tsc -w -p tsconfig.build.json\" \"node --watch-path=dist dist/main.js\"",
    "start": "node dist/main.js",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
